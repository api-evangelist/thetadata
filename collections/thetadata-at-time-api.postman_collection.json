              "type": "text/plain"
            },
            "url": {
              "path": [
                "stock",
                "at_time",
                "trade"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "symbol",
                  "value": "<string>",
                  "description": "(Required) The stock or index symbol, or underlying symbol for options."
