        {
          "id": "d0f79a42-6139-46e7-b65f-02d8ca104bc1",
          "name": "Trade",
          "request": {
            "name": "Trade",
            "description": {
              "content": "- Returns the last trade reported by [OPRA](/Articles/Data-And-Requests/The-SIPs.html) at a specified millisecond of the day.\n- Trade condition mappings can be found [here](/Articles/Errors-Exchanges-Conditions/Trade-Conditions.html).\n- Extended trade conditions are not reported by [OPRA](/Articles/Data-And-Requests/The-SIPs.html) for options, so they can be ignored.\n- The ``time_of_day``parameter represents the 00:00:00.000 ET that the trade should be provided for.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "option",
                "at_time",
                "trade"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "symbol",
                  "value": "<string>",
                  "description": "(Required) The stock or index symbol, or underlying symbol for options."
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "(Required) The start date (inclusive)."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "(Required) The end date (inclusive)."
                },
                {
                  "disabled": false,
                  "key": "time_of_day",
                  "value": "<time>",
                  "description": "(Required) The time of the day to fetch data for; assumed to be America/New_York."
                },
                {
                  "disabled": false,
                  "key": "expiration",
                  "value": "<date>",
                  "description": "(Required) The expiration of the contract in `YYYY-MM-DD` or `YYYYMMDD` format, or `*` for all expirations."
                },
                {
                  "disabled": false,
                  "key": "strike",
                  "value": "*",
                  "description": "The strike price of the contract in dollars (ie `100.00` for `$100.00`), or `*` for all strikes."
                },
                {
                  "disabled": false,
                  "key": "right",
                  "value": "both",
                  "description": "The right (call or put) of the contract."
                },
                {
                  "disabled": false,
                  "key": "max_dte",
                  "value": "<integer>",
                  "description": "If specified, only contracts with a full calendar day 'Days to Expiration' (DTE) less than or equal to this number will be returned."
                },
                {
                  "disabled": false,
                  "key": "strike_range",
                  "value": "<integer>",
                  "description": "Limits the number of contracts returned relative to the underlying's spot price. For a specified value 'n', this returns 'n' strikes above and 'n' strikes below the spot price, plus one at-the-money (ATM) strike (where spot price = strike price), if available. This results in a maximum of `2n + 1` strikes."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "csv",
                  "description": "The format of the data when returned to the user."
                }
